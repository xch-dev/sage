{
  "name": "sage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "vite",
    "dev:prepare": "node scripts/dev-prepare.mjs",
    "dev:system-apps": "node scripts/dev-system-apps-watch.mjs",
    "generate:bindings": "cargo run -p sage-tauri --features dev-tools --bin generate-bindings",
    "generate:bridge-types": "node scripts/generate-bridge-types.mjs",
    "generate:app-docs": "cargo run -p sage-apps --bin generate_docs",
    "generate:sdk-types": "pnpm --silent --filter sage-app-sdk run generate:types && pnpm --silent --filter sage-system-app-sdk run generate:types",
    "generate:types": "pnpm run generate:bridge-types && pnpm run generate:sdk-types",
    "build:packages": "pnpm --filter sage-app-sdk build && pnpm --filter sage-system-app-sdk build && pnpm --filter sage-app-ui build",
    "build:system-apps": "pnpm --dir builtin-apps/src/system build",
    "build:builtin-static": "node scripts/build-builtin-static.mjs",
    "build:builtin-apps": "pnpm run generate:app-docs && pnpm run build:packages && pnpm run build:system-apps && pnpm run build:builtin-static",
    "build:frontend": "tsc -b && vite build",
    "build": "pnpm run build:builtin-apps && pnpm run build:frontend",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "sandbox": "node scripts/sandbox.mjs",
    "tauri:build": "pnpm build && tauri build",
    "package:flatpak": "node scripts/package-flatpak.mjs",
    "check:flatpak-package": "node scripts/check-flatpak-package.mjs",
    "lint": "oxlint",
    "test:unit": "vitest run src",
    "preview": "vite preview",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "extract": "lingui extract",
    "compile": "lingui compile",
    "extract:watch": "lingui extract --watch"
  },
  "dependencies": {
    "@buildyourwebapp/tauri-plugin-sharesheet": "^0.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@fontsource/roboto": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-spring/web": "^10.1.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.6",
    "@tauri-apps/plugin-biometric": "^2.3.3",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-fs": "~2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@use-gesture/react": "^10.3.1",
    "@walletconnect/sign-client": "^2.26.0",
    "@walletconnect/types": "^2.26.0",
    "bech32": "^2.0.0",
    "bignumber.js": "^11.1.5",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^14.14.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.73.0",
    "pretty-bytes": "^7.2.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-number-format": "^5.4.5",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.2.0",
    "sage-app-sdk": "workspace:*",
    "sage-app-ui": "workspace:*",
    "spoiled": "^0.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tauri-plugin-safe-area-insets": "^0.1.0",
    "tauri-plugin-sage": "file:tauri-plugin-sage",
    "theme-o-rama": "0.4.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@lingui/cli": "^6.12.0",
    "@lingui/format-po": "^6.12.0",
    "@lingui/swc-plugin": "^6.7.1",
    "@lingui/vite-plugin": "^6.12.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "chokidar": "^6.0.0",
    "cross-spawn": "^7.0.6",
    "eslint-plugin-lingui": "^0.16.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "ts-prune": "^0.10.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  }
}
